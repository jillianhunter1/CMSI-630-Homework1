# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO `.env` AND ADD YOUR API KEY:
#   cp .env.example .env
#
# Get your free Gemini API key at: https://aistudio.google.com/
# NOTE: .env is listed in .gitignore and will never be committed to Git.
# ==============================================================================

# Google Gemini API Key (Free tier from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model (Defaults to gemini-3.8-flash)
# Options: gemini-3.8-flash, gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-3.8-flash
